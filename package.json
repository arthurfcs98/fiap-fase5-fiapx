{
  "name": "fiap-fase5-fiapx",
  "version": "0.1.0",
  "description": "FIAP Frames: processamento de vídeos em microsserviços (Hackathon SOAT Fase 5)",
  "author": "Arthur Cesarino",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "npm run build:video-api && npm run build:video-worker && npm run build:notification-service",
    "build:video-api": "nest build video-api",
    "build:video-worker": "nest build video-worker",
    "build:notification-service": "nest build notification-service",
    "start:dev:video-api": "nest start video-api --watch",
    "start:dev:video-worker": "nest start video-worker --watch",
    "start:dev:notification-service": "nest start notification-service --watch",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json --noEmit",
    "test": "jest",
    "test:cov": "node scripts/test-cov.mjs",
    "test:e2e": "jest -c apps/video-api/test/jest-e2e.config.js --runInBand",
    "test:int": "jest -c jest.int.config.js --runInBand --forceExit",
    "test:bdd": "jest -c tests/bdd/jest.config.js --runInBand",
    "prepare": "simple-git-hooks || echo \"simple-git-hooks: hooks não instalados (fora de um checkout git ou sem devDependencies)\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1142.0",
    "@aws-sdk/lib-storage": "3.1142.0",
    "@nest-lab/throttler-storage-redis": "1.2.0",
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/serve-static": "5.0.5",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "11.0.3",
    "@prometheus-io/client": "0.16.1",
    "amqp-connection-manager": "5.0.0",
    "amqplib": "2.2.0",
    "archiver": "7.0.1",
    "bcryptjs": "3.0.3",
    "busboy": "1.6.0",
    "file-type": "22.1.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nestjs-pino": "5.2.1",
    "nodemailer": "10.0.12",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "resend": "6.30.0",
    "rxjs": "7.8.2",
    "typeorm": "1.1.1",
    "uuid": "11.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.6",
    "@testcontainers/postgresql": "12.2.0",
    "@testcontainers/rabbitmq": "12.2.0",
    "@testcontainers/redis": "12.2.0",
    "@types/archiver": "7.0.0",
    "@types/busboy": "1.5.4",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.4",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "jest": "30.5.2",
    "jest-cucumber": "4.5.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "simple-git-hooks": "2.14.0",
    "supertest": "7.3.0",
    "testcontainers": "12.2.0",
    "ts-jest": "29.4.14",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  },
  "overrides": {
    "jest-cucumber": {
      "uuid": "$uuid"
    },
    "@cucumber/messages": {
      "uuid": "$uuid"
    }
  },
  "simple-git-hooks": {
    "pre-commit": "./scripts/git-hooks/pre-commit.sh"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,html,css}": "prettier --write --ignore-unknown"
  }
}

{
  "name": "fiap-fase5-fiapx",
  "version": "0.1.0",
  "description": "FIAP X: processamento de vídeos em microsserviços (Hackathon SOAT Fase 5)",
  "author": "Arthur Cesarino",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build": "npm run build:video-api && npm run build:video-worker && npm run build:notification-service",
    "build:video-api": "nest build video-api",
    "build:video-worker": "nest build video-worker",
    "build:notification-service": "nest build notification-service",
    "start:dev:video-api": "nest start video-api --watch",
    "start:dev:video-worker": "nest start video-worker --watch",
    "start:dev:notification-service": "nest start notification-service --watch",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json --noEmit",
    "test": "jest",
    "test:cov": "node scripts/test-cov.mjs",
    "test:e2e": "jest -c apps/video-api/test/jest-e2e.config.js --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@prometheus-io/client": "0.16.1",
    "nestjs-pino": "5.2.1",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.7",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.6",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.4",
    "@types/supertest": "7.2.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "jest": "30.5.2",
    "prettier": "3.9.9",
    "supertest": "7.3.0",
    "ts-jest": "29.4.14",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}

{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/video-api",
  "sourceRoot": "apps/video-api/src",
  "compilerOptions": {
    "webpack": true,
    "deleteOutDir": true,
    "tsConfigPath": "apps/video-api/tsconfig.app.json"
  },
  "projects": {
    "video-api": {
      "type": "application",
      "root": "apps/video-api",
      "entryFile": "main",
      "sourceRoot": "apps/video-api/src",
      "compilerOptions": { "tsConfigPath": "apps/video-api/tsconfig.app.json" }
    },
    "video-worker": {
      "type": "application",
      "root": "apps/video-worker",
      "entryFile": "main",
      "sourceRoot": "apps/video-worker/src",
      "compilerOptions": { "tsConfigPath": "apps/video-worker/tsconfig.app.json" }
    },
    "notification-service": {
      "type": "application",
      "root": "apps/notification-service",
      "entryFile": "main",
      "sourceRoot": "apps/notification-service/src",
      "compilerOptions": { "tsConfigPath": "apps/notification-service/tsconfig.app.json" }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": { "tsConfigPath": "libs/common/tsconfig.lib.json" }
    },
    "observability": {
      "type": "library",
      "root": "libs/observability",
      "entryFile": "index",
      "sourceRoot": "libs/observability/src",
      "compilerOptions": { "tsConfigPath": "libs/observability/tsconfig.lib.json" }
    },
    "messaging": {
      "type": "library",
      "root": "libs/messaging",
      "entryFile": "index",
      "sourceRoot": "libs/messaging/src",
      "compilerOptions": { "tsConfigPath": "libs/messaging/tsconfig.lib.json" }
    },
    "contracts": {
      "type": "library",
      "root": "libs/contracts",
      "entryFile": "index",
      "sourceRoot": "libs/contracts/src",
      "compilerOptions": { "tsConfigPath": "libs/contracts/tsconfig.lib.json" }
    },
    "storage": {
      "type": "library",
      "root": "libs/storage",
      "entryFile": "index",
      "sourceRoot": "libs/storage/src",
      "compilerOptions": { "tsConfigPath": "libs/storage/tsconfig.lib.json" }
    }
  }
}

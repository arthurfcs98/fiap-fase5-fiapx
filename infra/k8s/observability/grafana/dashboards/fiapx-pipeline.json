{
  "uid": "fiapx-pipeline",
  "title": "FIAP Frames — Pipeline de vídeos",
  "description": "Upload -> fila -> worker -> zip -> notificação: vazão, fila, escala, duração, falhas e recursos.",
  "tags": [
    "fiapx"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "weekStart": "",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [],
  "templating": {
    "list": [
      {
        "type": "custom",
        "name": "servico",
        "label": "Serviço",
        "description": "Serviços cujos logs aparecem no painel Logs.",
        "query": "video-api,video-worker,notification-service,rabbitmq,postgres,garage,redis",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "video-api",
            "video-worker",
            "notification-service"
          ],
          "value": [
            "video-api",
            "video-worker",
            "notification-service"
          ]
        },
        "options": [
          {
            "selected": false,
            "text": "All",
            "value": "$__all"
          },
          {
            "selected": true,
            "text": "video-api",
            "value": "video-api"
          },
          {
            "selected": true,
            "text": "video-worker",
            "value": "video-worker"
          },
          {
            "selected": true,
            "text": "notification-service",
            "value": "notification-service"
          },
          {
            "selected": false,
            "text": "rabbitmq",
            "value": "rabbitmq"
          },
          {
            "selected": false,
            "text": "postgres",
            "value": "postgres"
          },
          {
            "selected": false,
            "text": "garage",
            "value": "garage"
          },
          {
            "selected": false,
            "text": "redis",
            "value": "redis"
          }
        ],
        "hide": 0
      },
      {
        "type": "custom",
        "name": "nivel",
        "label": "Nível",
        "description": "Nível do log (pino).",
        "query": "error,warn,info,debug",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "$__all"
          },
          {
            "selected": false,
            "text": "error",
            "value": "error"
          },
          {
            "selected": false,
            "text": "warn",
            "value": "warn"
          },
          {
            "selected": false,
            "text": "info",
            "value": "info"
          },
          {
            "selected": false,
            "text": "debug",
            "value": "debug"
          }
        ],
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "correlationId",
        "label": "correlationId",
        "query": "",
        "current": {
          "text": "",
          "value": ""

        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Workers ativos (KEDA)",
      "description": "Réplicas do video-worker respondendo. O KEDA escala de 1 a 2 pelo tamanho da fila.",

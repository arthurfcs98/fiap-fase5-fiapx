    },
    {
      "id": 4,
      "type": "stat",
      "title": "Fila: em processamento",
      "description": "Mensagens entregues a um worker e ainda sem ack (vídeos sendo processados agora).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"

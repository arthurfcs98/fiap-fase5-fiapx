    {
      "id": 12,
      "type": "bargauge",
      "title": "Falhas por error_code (período do painel)",
      "description": "P0001-P0005: erro de entrada (vídeo inválido, sem frames, longo demais, timeout, origem sumiu). P0098/P0099: erro do sistema (conta no SLO).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (error_code) (increase(fiapx_videos_failed_total[$__range]))",
          "legendFormat": "{{error_code}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {

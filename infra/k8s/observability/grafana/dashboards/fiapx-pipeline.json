    {
      "id": 23,
      "type": "logs",
      "title": "Logs dos serviços (filtre por serviço, nível e correlationId no topo)",
      "description": "Loki (72 h), coletado pelo Grafana Alloy. Filtros no topo: serviço, nível e correlationId (o caminho HTTP -> outbox -> worker -> e-mail de uma requisição). Para navegar sem LogQL: menu Drilldown -> Logs.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{namespace=\"fiapx\", app=~\"${servico:regex}\", level=~\"${nivel:regex}\"} |= \"$correlationId\" | json",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Fluxo de vídeos",
      "collapsed": false,
      "gridPos": {

# video-api: configuração NÃO secreta (contratos.md, seções 10 e 12). Valores de produção
# (VM compartilhada); o overlay local sobrescreve o que muda no k3d.
# APP_VERSION NÃO entra aqui: vem da imagem (sha-<7>) e é o que o smoke do deploy confere.
NODE_ENV=production
LOG_LEVEL=info
NODE_OPTIONS=--max-old-space-size=192
PORT=3000
SWAGGER_ENABLED=true
METRICS_PORT=9464
METRICS_HOST=0.0.0.0
DB_HOST=postgres
DB_PORT=5432
DB_USER=fiapx_video
DB_NAME=fiapx_video
DB_SSL=false
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
S3_BUCKET_RAW=fiapx-raw
S3_BUCKET_ZIPS=fiapx-zips
S3_FORCE_PATH_STYLE=true
JWT_EXPIRES_IN=3600
# Endereço público oficial (contratos.md, seção 14): links de download e CORS. O Ingress continua
# atendendo fiapx.asdevit.com (host técnico usado pelo Caddy e pelo smoke do deploy.sh).
PUBLIC_BASE_URL=https://frames.asdevit.com
CORS_ORIGIN=https://frames.asdevit.com
MAX_UPLOAD_MB=95
ZIP_RETENTION_DAYS=7
DATA_RETENTION_INTERVAL_S=3600
PRIVACY_POLICY_VERSION=2026-09-28

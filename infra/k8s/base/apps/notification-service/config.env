# notification-service: configuração NÃO secreta (contratos.md, seções 10 e 12).
# RESEND_API_KEY é segredo: o overlay de produção monta o arquivo (RESEND_API_KEY_FILE).
NODE_ENV=production
LOG_LEVEL=info
NODE_OPTIONS=--max-old-space-size=128
METRICS_PORT=9464
METRICS_HOST=0.0.0.0
DB_HOST=postgres
DB_PORT=5432
DB_USER=fiapx_notification
DB_NAME=fiapx_notification
DB_SSL=false
EMAIL_PROVIDER=resend
# Marca visível ao usuário (contratos.md, seção 14): "FIAP Frames".
EMAIL_FROM=FIAP Frames <frames@asdevit.com>
# Só o e-mail de falha em produção (revisão D6/H2): o cadastro não verifica o e-mail, então cada
# e-mail de sucesso seria mais um que qualquer um pode disparar do nosso domínio para terceiros,
# e um pico gastaria a quota do Resend que os e-mails de falha precisam.
NOTIFY_ON_SUCCESS=false
NOTIFICATION_RETENTION_DAYS=30
# Orçamento de e-mails em 24 h: por usuário e total (abaixo da quota do Resend free, 100/dia).
NOTIFICATION_DAILY_LIMIT_PER_USER=10
NOTIFICATION_DAILY_LIMIT=80
# Link dos e-mails (a página inicial do app).
PUBLIC_BASE_URL=https://frames.asdevit.com

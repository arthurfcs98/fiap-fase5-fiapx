# =============================================================================
# FIAP X — variáveis do docker compose local/CI.
# NÃO edite para colocar segredos aqui: rode `make up` (ou scripts/dev-secrets.sh), que
# gera o `.env` (gitignored) a partir deste arquivo, preenchendo os segredos vazios com
# valores aleatórios. Valores já existentes no `.env` nunca são sobrescritos.
# =============================================================================

COMPOSE_PROJECT_NAME=fiapx

# ---- Imagens dos apps (build local por padrão) ------------------------------
FIAPX_IMAGE_PREFIX=ghcr.io/arthurfcs98/fiapx
FIAPX_IMAGE_TAG=local
APP_VERSION=dev
LOG_LEVEL=info

# ---- Portas publicadas no host (todas em 127.0.0.1, exceto a API) ------------
API_HOST_PORT=8080
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
RABBITMQ_HOST_PORT=5672
RABBITMQ_UI_HOST_PORT=15672
MAILPIT_UI_HOST_PORT=8025
MAILPIT_SMTP_HOST_PORT=1025
GARAGE_S3_HOST_PORT=3900
GARAGE_ADMIN_HOST_PORT=3903

# ---- Segredos locais (deixe VAZIO: o dev-secrets.sh gera) --------------------
POSTGRES_PASSWORD=
VIDEO_DB_PASSWORD=
NOTIF_DB_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_PASSWORD=
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_METRICS_TOKEN=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
METRICS_TOKEN=
